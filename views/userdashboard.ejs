  <script>
  let currentFileFilter = 'all';
  let currentTab = 'files';
  let currentPreviewFileId = null;

  // Tab switching
  function switchFileTab(tab, btn) {
    currentTab = tab;
    document.querySelectorAll('.file-tab').forEach(t => t.classList.remove('active'));
    if (btn) btn.classList.add('active');
    document.getElementById('myFilesSection').style.display = tab === 'files' ? '' : 'none';
    document.getElementById('sharedFilesSection').style.display = tab === 'shared' ? '' : 'none';
    document.getElementById('recycleBinSection').style.display = tab === 'recycle' ? '' : 'none';
    document.querySelector('.filters').style.display = tab === 'files' ? '' : 'none';
    document.getElementById('bulkToolbar').classList.remove('show');
    if (tab === 'recycle') loadRecycleBin();
  }

  // Recycle bin
  async function loadRecycleBin() {
    try {
      const res = await fetch('/auth/recycle-bin', { credentials: 'same-origin' });
      if (!res.ok) throw new Error(`Server error: ${res.status}`);
      const data = await res.json();
      const container = document.getElementById('recycleBinContainer');
      if (!data.success || !data.files.length) {
        container.innerHTML = '<p>Recycle bin is empty</p>';
        return;
      }
      container.innerHTML = data.files.map(f => {
        const deletedDate = f.deletedAt ? new Date(f.deletedAt).toLocaleDateString() : '';
        const safeId = escapeHtml(f._id);
        return `<div class="file-card recycled" data-file-id="${safeId}">
          <span class="file-icon-lg"><i class="ri-file-text-line"></i></span>
          <p>${escapeHtml(f.originalName || f.filename)}</p>
          <span class="text-hint">Deleted ${escapeHtml(deletedDate)}</span>
          <div style="margin-top:0.5rem;display:flex;gap:0.3rem;">
            <button class="btn-action btn-restore" onclick="event.stopPropagation();restoreFile(this.closest('.file-card').dataset.fileId)"><i class="ri-recycle-line"></i> Restore</button>
            <button class="btn-action btn-danger" onclick="event.stopPropagation();purgeFile(this.closest('.file-card').dataset.fileId)"><i class="ri-delete-bin-line"></i> Purge</button>
          </div>
        </div>`;
      }).join('');
    } catch (e) { console.error('loadRecycleBin error', e); }
  }

  async function restoreFile(fileId) {
    try {
      const data = await postNoBody('/auth/recycle-bin/restore/' + encodeURIComponent(fileId));
      if (data.success) { showFeedbackToast('File restored', 'success'); setTimeout(() => location.reload(), 700); }
      else showFeedbackToast('' + (data.message || 'Restore failed'), 'error');
    } catch (e) { showFeedbackToast('Error', 'error'); }
  }

  async function purgeFile(fileId) {
    openActionConfirm('<i class="ri-delete-bin-line"></i> Permanently Delete', 'This will permanently delete the file and all versions. This cannot be undone.', 'Purge', 'danger', async () => {
      try {
        const data = await postNoBody('/auth/recycle-bin/purge/' + encodeURIComponent(fileId));
        if (data.success) { showFeedbackToast('File permanently deleted', 'success'); loadRecycleBin(); }
        else showFeedbackToast('' + (data.message || 'Purge failed'), 'error');
      } catch (e) { showFeedbackToast('Error', 'error'); }
    });
  }

  // Bulk operations
  function updateBulkToolbar() {
    const checked = document.querySelectorAll('.file-card-check:checked');
    const toolbar = document.getElementById('bulkToolbar');
    const countEl = document.getElementById('bulkCount');
    if (checked.length > 0) {
      toolbar.classList.add('show');
      countEl.textContent = checked.length + ' selected';
      checked.forEach(cb => cb.closest('.file-card').classList.add('selected'));
    } else {
      toolbar.classList.remove('show');
    }
    // deselect unchecked
    document.querySelectorAll('.file-card-check:not(:checked)').forEach(cb => cb.closest('.file-card').classList.remove('selected'));
  }

  function clearBulkSelection() {
    document.querySelectorAll('.file-card-check:checked').forEach(cb => { cb.checked = false; cb.closest('.file-card').classList.remove('selected'); });
    document.getElementById('bulkToolbar').classList.remove('show');
  }

  function getSelectedIds() {
    return Array.from(document.querySelectorAll('.file-card-check:checked')).map(cb => cb.getAttribute('data-id'));
  }

  async function bulkDelete() {
    const ids = getSelectedIds();
    if (!ids.length) return;
    openActionConfirm('<i class="ri-delete-bin-line"></i> Bulk Delete', `Move ${ids.length} file(s) to recycle bin?`, 'Delete', 'danger', async () => {
      try {
        const res = await fetch('/auth/file/bulk-delete', {
          method: 'POST', credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': window.RequestHelpers.getCsrfToken() || '' },
          body: JSON.stringify({ fileIds: ids })
        });
        const data = await res.json();
        if (data.success) { showFeedbackToast('' + data.message, 'success'); setTimeout(() => location.reload(), 700); }
        else showFeedbackToast('' + (data.message || 'Bulk delete failed'), 'error');
      } catch (e) { showFeedbackToast('Error', 'error'); }
    });
  }

  function bulkDownload() {
    const ids = getSelectedIds();
    if (!ids.length) return;
    window.location.href = '/auth/file/bulk-download?ids=' + ids.join(',');
  }

  // Server-side search
  async function serverSearch() {
    const q = (document.getElementById('searchInput').value || '').trim();
    const from = document.getElementById('searchFrom').value;
    const to = document.getElementById('searchTo').value;
    if (!q && !from && !to) { applyFileFilters(); return; }

    try {
      const params = new URLSearchParams();
      if (q) params.set('q', q);
      if (from) params.set('from', from);
      if (to) params.set('to', to);
      const res = await fetch('/auth/api/search?' + params.toString(), { credentials: 'same-origin' });
      const data = await res.json();
      if (!data.success) return;

      const container = document.getElementById('filesContainer');
      if (!data.files.length) { container.innerHTML = '<p>No results found</p>'; return; }
      container.innerHTML = data.files.map(f => {
        const ext = (f.filename||'').toLowerCase().split('.').pop();
        const isImg = ['jpg','jpeg','png','gif','bmp','webp','svg'].includes(ext);
        const extCategory = isImg ? 'image' : (ext === 'pdf' ? 'pdf' : ((ext === 'docx' || ext === 'doc') ? 'docx' : (['xls','xlsx','csv'].includes(ext) ? 'excel' : 'other')));
        const tagsHtml = (f.tags||[]).map(t => `<span class="file-tag">${escapeHtml(t)}</span>`).join('');
        return `<div class="file-card" data-category="${escapeHtml(extCategory)}" data-file-id="${escapeHtml(f._id)}" data-filename="${escapeHtml(f.filename)}" data-filetype="${escapeHtml(f.filetype)}" onclick="openPreview(this.dataset.filename, this.dataset.filetype, this.dataset.fileId)">
          ${f.version > 1 ? `<span class="version-badge">v${parseInt(f.version)}</span>` : ''}
          ${isImg ? `<img src="/uploads/${encodeURIComponent(f.filename)}" class="file-thumb" alt="" />` : '<span class="file-icon-lg"><i class="ri-file-text-line"></i></span>'}
          <p>${escapeHtml(f.originalName || f.filename)}</p>
          <span class="file-category">${escapeHtml(extCategory.toUpperCase())}</span>
          ${tagsHtml ? `<div class="file-tags">${tagsHtml}</div>` : ''}
        </div>`;
      }).join('');
    } catch (e) { console.error('search error', e); }
  }

  // Storage usage
  async function loadStorageUsage() {
    try {
      const res = await fetch('/auth/api/storage', { credentials: 'same-origin' });
      const data = await res.json();
      if (!data.success || !data.quotaBytes) return;
      const pct = Math.min(100, (data.usedBytes / data.quotaBytes) * 100);
      document.getElementById('storageBarFill').style.width = pct + '%';
      const usedMB = (data.usedBytes / (1024*1024)).toFixed(1);
      const quotaMB = (data.quotaBytes / (1024*1024)).toFixed(1);
      document.getElementById('storageText').textContent = `${usedMB} MB / ${quotaMB} MB used (${data.fileCount} files)`;
      document.getElementById('storageBarWrap').style.display = '';
    } catch (e) {}
  }
  loadStorageUsage();

  function applyFileFilters() {
    const query = (document.getElementById('searchInput')?.value || '').toLowerCase();
    const cards = document.querySelectorAll('.file-card');

    cards.forEach(card => {
      const name = (card.querySelector('p')?.textContent || '').toLowerCase();
      const extensionCategory = card.getAttribute('data-category');
      const matchesSearch = name.includes(query);
      const matchesCategory = currentFileFilter === 'all' || extensionCategory === currentFileFilter;
      card.style.display = (matchesSearch && matchesCategory) ? 'block' : 'none';
    });
  }

  function searchFiles() {
    const headerInput = document.getElementById('headerSearchInput');
    const enhancedInput = document.getElementById('searchInput');
    if (headerInput && enhancedInput && headerInput.value) {
      enhancedInput.value = headerInput.value;
    }
    applyFileFilters();
  }

  function filterFiles(category, btn) {
    currentFileFilter = category;
    document.querySelectorAll('.filters .filter-btn').forEach(button => button.classList.remove('active'));
    if (btn) btn.classList.add('active');
    applyFileFilters();
  }

  let pendingAction = null;

  function openActionConfirm(title, message, confirmText, variant, onConfirm) {
    const modal = document.getElementById('actionConfirmModal');
    const titleEl = document.getElementById('confirmTitle');
    const messageEl = document.getElementById('confirmMessage');
    const okBtn = document.getElementById('confirmOkBtn');
    if (!modal || !titleEl || !messageEl || !okBtn) return;

    titleEl.textContent = '';
    var iconMatch = title ? title.match(/^<i\s+class="(ri-[a-z0-9-]+)"\s*><\/i>\s*/) : null;
    if (iconMatch) {
      var icon = document.createElement('i');
      icon.className = iconMatch[1];
      icon.style.marginRight = '8px';
      titleEl.appendChild(icon);
      titleEl.appendChild(document.createTextNode(title.replace(iconMatch[0], '')));
    } else {
      titleEl.textContent = title || 'Confirm Action';
    }
    messageEl.textContent = message || 'Are you sure?';
    okBtn.textContent = confirmText || 'Confirm';
    okBtn.classList.remove('primary', 'danger');
    okBtn.classList.add(variant === 'danger' ? 'danger' : 'primary');
    pendingAction = typeof onConfirm === 'function' ? onConfirm : null;

    modal.classList.add('show');
    modal.setAttribute('aria-hidden', 'false');
  }

  function closeActionConfirm() {
    const modal = document.getElementById('actionConfirmModal');
    if (!modal) return;
    modal.classList.remove('show');
    modal.setAttribute('aria-hidden', 'true');
    pendingAction = null;
  }

  function confirmActionProceed() {
    const action = pendingAction;
    closeActionConfirm();
    if (action) action();
  }

  function showFeedbackToast(message, type) {
    const modal = document.getElementById('feedbackModal');
    const feedbackBox = document.getElementById('feedbackBox');
    const feedbackMessage = document.getElementById('feedbackMessage');
    if (!modal || !feedbackBox || !feedbackMessage) return;

    const iconMap = { success: 'ri-check-line', error: 'ri-close-circle-line', info: 'ri-information-line' };
    const iconClass = iconMap[type] || iconMap.info;
    const iconEl = document.createElement('i');
    iconEl.className = iconClass;
    feedbackMessage.textContent = '';
    feedbackMessage.appendChild(iconEl);
    feedbackMessage.append(' ' + message);
    feedbackBox.className = type === 'error' ? 'modal-content error' : 'modal-content success';
    modal.classList.add('show');
    setTimeout(() => modal.classList.remove('show'), 2200);
  }

  document.getElementById('searchInput')?.addEventListener('input', applyFileFilters);

  function openPreview(filename, filetype, fileId) {
    currentPreviewFileId = fileId;
    document.getElementById('previewTitle').textContent = filename;
    const downloadBtn = document.getElementById('downloadBtn');
    downloadBtn.onclick = function() {
      openActionConfirm(
        '<i class="ri-download-line"></i> Download File',
        `Do you want to download this file?\n\n${filename}`,
        'Download',
        'primary',
        function() {
          const link = document.createElement('a');
          link.href = `/uploads/${encodeURIComponent(filename)}`;
          link.setAttribute('download', filename);
          document.body.appendChild(link);
          link.click();
          link.remove();
        }
      );
    };

    const previewArea = document.getElementById('previewArea');
    previewArea.innerHTML = '';

    // Determine actual file type by extension for proper preview rendering
    const ext = filename.toLowerCase().split('.').pop();
    const isImage = ['jpg', 'jpeg', 'png', 'gif', 'bmp', 'webp', 'svg'].includes(ext);
    const isPdf = ext === 'pdf';
    const isDocx = ext === 'docx' || ext === 'doc';
    const isXlsx = ext === 'xlsx' || ext === 'xls' || ext === 'csv';

    if (isImage) {
      previewArea.innerHTML = `<img id="previewImg" src="/uploads/${encodeURIComponent(filename)}" alt="${escapeHtml(filename)}" class="preview-img" />`;
      document.getElementById('viewBtn').onclick = function() {
        openActionConfirm(
          '<i class="ri-eye-line"></i> View File',
          `Do you want to view this file?\n\n${filename}`,
          'View',
          'primary',
          function() {
            const img = document.getElementById('previewImg');
            if (img && img.requestFullscreen) img.requestFullscreen();
            else window.open('/uploads/' + encodeURIComponent(filename), '_blank');
          }
        );
      };
    } else if (isPdf) {
      previewArea.innerHTML = '<div id="pdfLoader" class="pdf-loader">Rendering preview <span class="dot"></span><span class="dot"></span><span class="dot"></span></div><canvas id="pdfCanvas" class="preview-canvas" style="display:none;"></canvas>';
      try {
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.worker.min.js';
        const loadingTask = pdfjsLib.getDocument('/uploads/' + filename);
        loadingTask.promise.then(function(pdf) {
          pdf.getPage(1).then(function(page) {
            const viewport = page.getViewport({ scale: 1.2 });
            const canvas = document.getElementById('pdfCanvas');
            const context = canvas.getContext('2d');
            canvas.height = viewport.height;
            canvas.width = viewport.width;
            const renderContext = { canvasContext: context, viewport: viewport };
            page.render(renderContext).promise.then(function() {
              const loader = document.getElementById('pdfLoader');
              if (loader) loader.style.display = 'none';
              canvas.style.display = 'block';
            }).catch(function(err) {
              const loader = document.getElementById('pdfLoader');
              if (loader) loader.style.display = 'none';
              previewArea.innerHTML = '<div class="text-error">Unable to render PDF preview</div>';
              console.error('PDF page render error', err);
            });
          }).catch(function(err) {
            const loader = document.getElementById('pdfLoader');
            if (loader) loader.style.display = 'none';
            previewArea.innerHTML = '<div class="text-error">Unable to get PDF page</div>';
            console.error('PDF getPage error', err);
          });
        }).catch(function(err) {
          const loader = document.getElementById('pdfLoader');
          if (loader) loader.style.display = 'none';
          previewArea.innerHTML = '<div class="text-error">Unable to load PDF</div>';
          console.error('PDF load error', err);
        });
      } catch (err) {
        const loader = document.getElementById('pdfLoader');
        if (loader) loader.style.display = 'none';
        previewArea.innerHTML = '<div class="text-error">PDF preview error</div>';
        console.error('PDF preview init error', err);
      }
      document.getElementById('viewBtn').onclick = function() {
        openActionConfirm(
          '<i class="ri-eye-line"></i> View File',
          `Do you want to view this file?\n\n${filename}`,
          'View',
          'primary',
          function() { window.open('/uploads/' + encodeURIComponent(filename), '_blank'); }
        );
      };
    } else if (isDocx || isXlsx) {
      // DOCX/XLSX server-side preview
      previewArea.innerHTML = '<div class="text-loading">Loading preview...</div>';
      fetch('/auth/file/preview/' + encodeURIComponent(fileId), { credentials: 'same-origin' })
        .then(r => {
          if (!r.ok) throw new Error(`Server error: ${r.status}`);
          return r.json();
        })
        .then(data => {
          if (data.success) {
            previewArea.innerHTML = `<div class="docx-preview">${data.html}</div>`;
          } else {
            previewArea.innerHTML = `<div class="fallback-icon"><i class="ri-file-text-line"></i></div><p>${escapeHtml(filename)}</p>`;
          }
        })
        .catch(() => {
          previewArea.innerHTML = `<div class="fallback-icon"><i class="ri-file-text-line"></i></div><p>${escapeHtml(filename)}</p>`;
        });
      document.getElementById('viewBtn').onclick = function() {
        openActionConfirm('<i class="ri-eye-line"></i> View File', `Do you want to view this file?\n\n${filename}`, 'View', 'primary',
          function() { window.open('/uploads/' + encodeURIComponent(filename), '_blank'); }
        );
      };
    } else {
      previewArea.innerHTML = `<div class="fallback-icon"><i class="ri-file-text-line"></i></div><p>${escapeHtml(filename)}</p>`;
      document.getElementById('viewBtn').onclick = function() {
        openActionConfirm(
          '<i class="ri-eye-line"></i> View File',
          `Do you want to view this file?\n\n${filename}`,
          'View',
          'primary',
          function() { window.open('/uploads/' + encodeURIComponent(filename), '_blank'); }
        );
      };
    }

    const deleteBtn = document.getElementById('deleteBtnFile');
    if (deleteBtn) deleteBtn.remove();

    // All users can delete their own files (soft delete)
    const newDeleteBtn = document.createElement('button');
    newDeleteBtn.id = 'deleteBtnFile';
    newDeleteBtn.className = 'btn-action btn-danger';
    newDeleteBtn.innerHTML = '<i class="ri-delete-bin-line"></i> Delete';
    newDeleteBtn.onclick = function() {
      deleteUserFile(fileId);
    };
    downloadBtn.parentElement.appendChild(newDeleteBtn);

    // Show tags section (only for own files)
    const tagsSection = document.getElementById('previewTagsSection');
    const shareSection = document.getElementById('previewShareSection');
    const versionSection = document.getElementById('previewVersionSection');
    tagsSection.style.display = '';
    shareSection.style.display = '';
    versionSection.style.display = 'none';

    // Load tags from the card
    const cardEl = document.querySelector(`.file-card[data-file-id="${fileId}"]`);
    const existingTags = cardEl ? Array.from(cardEl.querySelectorAll('.file-tag')).map(e => e.textContent) : [];
    document.getElementById('previewTagsList').innerHTML = existingTags.map(t => `<span class="file-tag">${escapeHtml(t)}</span>`).join('');
    document.getElementById('previewTagsInput').value = existingTags.join(', ');

    // Load version history
    loadVersionHistory(fileId);

    document.getElementById('shareLinkResult').style.display = 'none';
    document.getElementById('shareEmailsInput').value = '';

    document.getElementById('previewModal').classList.add('show');
  }

  // Tags save
  async function saveFileTags() {
    if (!currentPreviewFileId) return;
    const tags = document.getElementById('previewTagsInput').value;
    try {
      const res = await fetch('/auth/file/tags/' + encodeURIComponent(currentPreviewFileId), {
        method: 'POST', credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': window.RequestHelpers.getCsrfToken() || '' },
        body: JSON.stringify({ tags })
      });
      const data = await res.json();
      if (data.success) {
        document.getElementById('previewTagsList').innerHTML = (data.tags||[]).map(t => `<span class="file-tag">${escapeHtml(t)}</span>`).join('');
        showFeedbackToast('Tags saved', 'success');
        // Update card tags
        const card = document.querySelector(`.file-card[data-file-id="${currentPreviewFileId}"]`);
        if (card) {
          let tagsDiv = card.querySelector('.file-tags');
          if (!tagsDiv) { tagsDiv = document.createElement('div'); tagsDiv.className = 'file-tags'; card.appendChild(tagsDiv); }
          tagsDiv.innerHTML = (data.tags||[]).map(t => `<span class="file-tag">${escapeHtml(t)}</span>`).join('');
        }
      } else showFeedbackToast('' + (data.message || 'Failed'), 'error');
    } catch (e) { showFeedbackToast('Error', 'error'); }
  }

  // Share with users
  async function shareFileWithUsers() {
    if (!currentPreviewFileId) return;
    const raw = document.getElementById('shareEmailsInput').value.trim();
    if (!raw) return;
    const emails = raw.split(',').map(e => e.trim()).filter(Boolean);
    try {
      const res = await fetch('/auth/file/share/' + encodeURIComponent(currentPreviewFileId), {
        method: 'POST', credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': window.RequestHelpers.getCsrfToken() || '' },
        body: JSON.stringify({ emails })
      });
      if (!res.ok) throw new Error(`Server error: ${res.status}`);
      const data = await res.json();
      if (data.success) {
        showFeedbackToast('Shared with ' + (data.sharedWith||[]).join(', '), 'success');
      } else showFeedbackToast('' + (data.message || 'Failed'), 'error');
    } catch (e) { showFeedbackToast('Error', 'error'); }
  }

  // Create share link
  async function createShareLink() {
    if (!currentPreviewFileId) return;
    const expiresInHours = Number(document.getElementById('shareLinkExpiry').value) || 24;
    const maxDownloads = Number(document.getElementById('shareLinkMaxDl').value) || 0;
    try {
      const res = await fetch('/auth/file/share-link/' + encodeURIComponent(currentPreviewFileId), {
        method: 'POST', credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': window.RequestHelpers.getCsrfToken() || '' },
        body: JSON.stringify({ expiresInHours, maxDownloads })
      });
      if (!res.ok) throw new Error(`Server error: ${res.status}`);
      const data = await res.json();
      if (data.success) {
        const resultEl = document.getElementById('shareLinkResult');
        resultEl.style.display = '';
        const safeUrl = escapeHtml(data.shareUrl || '');
        resultEl.innerHTML = `<strong>Share URL:</strong> <a href="${safeUrl}" target="_blank">${safeUrl}</a><br><small>Expires: ${escapeHtml(new Date(data.expiresAt).toLocaleString())}</small>`;
      } else showFeedbackToast('' + (data.message || 'Failed'), 'error');
    } catch (e) { showFeedbackToast('Error', 'error'); }
  }

  // Version history
  async function loadVersionHistory(fileId) {
    try {
      const res = await fetch('/auth/file/versions/' + encodeURIComponent(fileId), { credentials: 'same-origin' });
      if (!res.ok) throw new Error(`Server error: ${res.status}`);
      const data = await res.json();
      if (data.success && data.versions && data.versions.length) {
        const section = document.getElementById('previewVersionSection');
        section.style.display = '';
        const list = document.getElementById('versionHistoryList');
        list.innerHTML = `<div class="preview-version-header"><strong>Current: v${data.currentVersion}</strong></div>` +
          data.versions.map(v => `<div class="preview-version-row">v${data.versions.indexOf(v)+1} â€” ${(v.sizeBytes/1024).toFixed(1)}KB â€” ${new Date(v.uploadedAt).toLocaleString()}</div>`).join('');
      }
    } catch (e) {}
  }

  function deleteUserFile(fileId) {
    openActionConfirm(
      '<i class="ri-delete-bin-line"></i> Delete File',
      'This file will be moved to the recycle bin. You can restore it within 30 days.',
      'Delete',
      'danger',
      async function() {
        try {
          const data = await postNoBody(`/auth/file/delete/${encodeURIComponent(fileId)}`);
          if (data.success) {
            showFeedbackToast('File moved to recycle bin', 'success');
            setTimeout(() => location.reload(), 700);
          } else {
            showFeedbackToast('' + (data.message || 'Delete failed'), 'error');
          }
        } catch (err) {
          showFeedbackToast('Error: ' + (err.message || 'Delete failed'), 'error');
        }
      }
    );
  }

  function closePreview() {
    document.getElementById('previewModal').classList.remove('show');
  }

  document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') {
      closePreview();
      closeProfileModal();
      closeActionConfirm();
    }
  });

  const confirmCancelBtn = document.getElementById('confirmCancelBtn');
  const confirmOkBtn = document.getElementById('confirmOkBtn');
  if (confirmCancelBtn) confirmCancelBtn.addEventListener('click', closeActionConfirm);
  if (confirmOkBtn) confirmOkBtn.addEventListener('click', confirmActionProceed);
  </script>

  <%- include('partials/scripts', { email: email, fullname: fullname, role: role }) %>

</body>
</html>


