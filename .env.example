# Runtime
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Database
MONGO_URI=mongodb://127.0.0.1:27017/centralize_file_system

# JWT access + refresh lifecycle
JWT_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_ISSUER=centralized-file-system
JWT_AUDIENCE=centralized-file-system-web
JWT_CLOCK_TOLERANCE_SECONDS=90

# JWT asymmetric keys (RS256)
# You can provide inline PEM values with \n escapes, or file paths.
JWT_ACTIVE_KID=local-dev-key-1
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
# Optional map for key rotation: {"kid-1":"./keys/public1.pem","kid-2":"-----BEGIN PUBLIC KEY-----\\n..."}
JWT_PUBLIC_KEYS_JSON=

# Upload controls
UPLOAD_DUPLICATE_WINDOW_MINUTES=10

# Optional one-time super admin seeding
# Set to true only when you intentionally want automatic seed creation.
ENABLE_DEFAULT_SUPERADMIN_SEED=false
DEFAULT_SUPERADMIN_EMAIL=
DEFAULT_SUPERADMIN_PASSWORD=

# Web Push Notifications (VAPID keys)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@doj-ppa.gov.ph

# Email (nodemailer)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@doj-ppa.gov.ph

# Logging
LOG_LEVEL=info
